{
  "name": "race-for-the-prize",
  "version": "0.9.2",
  "description": "🏆 Race browsers head-to-head and crown a champion",
  "type": "module",
  "bin": {
    "race-for-the-prize": "./race.js"
  },
  "files": [
    "race.js",
    "*.cjs",
    "cli/",
    "scripts/postinstall.cjs",
    "races/*/*.spec.js",
    "races/*/*.html",
    "races/*/settings.json",
    "ReadMe.md",
    "docs/skinning.md",
    "INSTALLATION.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "race": "node race.js"
  },
  "keywords": [
    "browser",
    "performance",
    "playwright",
    "benchmark",
    "race",
    "comparison"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kertal/race-for-the-prize.git"
  },
  "author": "kertal",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "vitest": "^4.1.5"
  }
}
